{
  "name": "cogitator",
  "displayName": "cogitator (dbt language server)",
  "description": "dbt SQL/YAML intelligence via the cogitator language server: navigation, lineage, diagnostics, dbt run/test/compile/preview.",
  "version": "0.6.0",
  "publisher": "sirh3e",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sirh3e/dbt-language-server"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "cogitator",
      "properties": {
        "cogitator.serverPath": {
          "type": "string",
          "default": "cogitator",
          "description": "Path to the cogitator executable (default: resolved on PATH)."
        },
        "cogitator.serverArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra CLI arguments (e.g. --profiles-dir, --target, --fusion)."
        },
        "cogitator.highlight.onOpen": {
          "type": "string",
          "enum": ["auto", "always", "off"],
          "default": "auto",
          "description": "Colour the project's SQL and YAML files from the server (tree-sitter-dbt, tree-sitter-yaml, dbt-aware captures) when they open and after edits. auto leaves YAML's own colours to VS Code and paints Jinja, SQL and dbt meaning over them; always paints every layer."
        }
      }
    },
    "commands": [
      {
        "command": "cogitator.run",
        "title": "dbt: Run current model"
      },
      {
        "command": "cogitator.test",
        "title": "dbt: Test current model"
      },
      {
        "command": "cogitator.compile",
        "title": "dbt: Compile current model"
      },
      {
        "command": "cogitator.preview",
        "title": "dbt: Preview current model (dbt show)"
      },
      {
        "command": "cogitator.previewCte",
        "title": "dbt: Preview rows of the CTE under the cursor"
      },
      {
        "command": "cogitator.parse",
        "title": "dbt: Parse project (refresh context)"
      },
      {
        "command": "cogitator.lineage",
        "title": "dbt: Show column lineage"
      },
      {
        "command": "cogitator.splitPlan",
        "title": "dbt: Split model at its incrementality frontier"
      },
      {
        "command": "cogitator.incrementalDiff",
        "title": "dbt: Compare incremental / full refresh"
      },
      {
        "command": "cogitator.incrementality",
        "title": "dbt: Table models that could be incremental"
      },
      {
        "command": "cogitator.syntaxTree",
        "title": "dbt: Show syntax tree"
      },
      {
        "command": "cogitator.highlight",
        "title": "dbt: Highlight with tree-sitter-dbt"
      },
      {
        "command": "cogitator.astGrep",
        "title": "dbt: Structural search (ast-grep)"
      },
      {
        "command": "cogitator.nodeInfo",
        "title": "dbt: Show node info"
      },
      {
        "command": "cogitator.unresolved",
        "title": "dbt: Unresolved references"
      },
      {
        "command": "cogitator.breakingChanges",
        "title": "dbt: Breaking changes against the last build"
      },
      {
        "command": "cogitator.modelDependencies",
        "title": "dbt: Model dependencies"
      },
      {
        "command": "cogitator.select",
        "title": "dbt: Select nodes…"
      },
      {
        "command": "cogitator.lineageView",
        "title": "dbt: Show lineage view"
      },
      {
        "command": "cogitator.syncYaml",
        "title": "dbt: Sync schema YAML"
      },
      {
        "command": "cogitator.status",
        "title": "dbt: Language server status"
      },
      {
        "command": "cogitator.restart",
        "title": "dbt: Restart language server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.82.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.4.5"
  }
}
