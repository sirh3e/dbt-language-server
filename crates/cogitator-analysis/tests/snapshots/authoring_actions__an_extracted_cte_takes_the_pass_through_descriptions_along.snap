=== models/marts/_marts__models.yml (edited)
version: 2

models:
  - name: crust_hops_more
    description: The crusts again, a hop further.

  - name: crust_report
    description: A report on crusts.
    columns:
      - name: crust_id
        description: The crust, as reported.
      - name: loaf_id
        description: The loaf, as reported.
      - name: crunch
        description: Twice the crunch.

  - name: crusts
    columns:
      - name: crust_id
        description: "The crust, as reported."
      - name: loaf_id
        description: "The loaf, as reported."

  - name: tested_model
    columns:
      - name: id
        data_tests:
          - unique

  - name: crust_relay
    columns:
      - name: crust_id
      - name: loaf_id
        description: Written here, kept.

  - name: crust_double
    columns:
      - name: crust_id
      - name: crunch

  - name: loaf_ids
    columns:
      - name: id

=== models/marts/crust_report.sql (edited)
with

loud as (

    select crust_id, loaf_id, crunch * 2 as crunch from {{ ref('crusts') }} as crusts

)

select crust_id, loaf_id, crunch from loud

