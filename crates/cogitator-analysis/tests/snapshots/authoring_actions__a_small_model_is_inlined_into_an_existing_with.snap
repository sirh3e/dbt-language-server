=== models/marts/crust_report.sql (edited)
with

crust_hops_more as (

    select crust_id, loaf_id, crunch from {{ ref('stg_bakery__crusts') }}

),

crusts as (

    select crust_id, loaf_id, crunch from crust_hops_more

),

loud as (

    select crust_id, loaf_id, crunch * 2 as crunch from crusts

)

select crust_id, loaf_id, crunch from loud
