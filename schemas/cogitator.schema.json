{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/sirh3e/dbt-language-server/main/schemas/cogitator.schema.json",
  "title": "cogitator.yml",
  "description": "The cogitator dbt language server's per-project configuration file. Every section except 'startup:' hot-reloads; 'startup:' keys apply only via --config at launch.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "limits": {
      "description": "Hot-tunable size caps.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_mib": {
          "description": "target/ artifact files past this size are skipped. (MiB)",
          "type": "integer",
          "minimum": 0
        },
        "compiled_sql_mib": {
          "description": "dbt.compiledSql wire cap; bigger files answer uri-only. (MiB)",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lint": {
      "description": "Opt-in style diagnostics; every check defaults to off.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dead_models": {
          "description": "Hint on models nothing downstream uses. (bool)",
          "type": "boolean"
        },
        "select_star": {
          "description": "Warn on SELECT * outside staging models. (bool)",
          "type": "boolean"
        },
        "trailing_comma": {
          "description": "Warn on trailing commas the dialect rejects. (bool)",
          "type": "boolean"
        },
        "unaliased_columns": {
          "description": "Warn on bare columns in multi-relation FROM/JOINs. (bool)",
          "type": "boolean"
        },
        "undocumented_columns": {
          "description": "Hint on produced columns missing from the schema YAML. (bool)",
          "type": "boolean"
        }
      }
    },
    "log": {
      "description": "What reaches the editor's log view (window/logMessage).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_level": {
          "description": "Verbosity of the editor-visible log stream; $/setTrace adjusts it too (last writer wins). (off|error|warn|info|debug)",
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ]
        }
      }
    },
    "perf": {
      "description": "Query-plan performance diagnostics; dbt.queryPlan always works, whatever is set here.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog_stats": {
          "description": "Use catalog statistics when ordering findings; statistics never raise a severity. (bool)",
          "type": "boolean"
        },
        "profile": {
          "description": "Which rules report as diagnostics: off (default), recommended or strict. (off|recommended|strict)",
          "type": "string",
          "enum": [
            "off",
            "recommended",
            "strict"
          ]
        }
      }
    },
    "perf_rules": {
      "description": "Per-rule severity, by rule id; wins over the profile. A rule named here reports even under profile off.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cross.duplicate_logic": {
          "description": "Same logic as another model. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "cross.ephemeral_repeat": {
          "description": "Ephemeral model recomputed in each consumer. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "cross.filter_late": {
          "description": "Every consumer repeats the same filter. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "cross.select_star_chain": {
          "description": "SELECT * reading columns nothing downstream uses (also lint.select_star). (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "cross.unused_column": {
          "description": "No downstream use in this project. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "filter.cluster_order": {
          "description": "Filter skips the leading cluster column. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "filter.constant_false": {
          "description": "Filter is always false. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "filter.non_sargable": {
          "description": "Wrapped column may block pruning. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "filter.partition_or": {
          "description": "OR defeats partition pruning. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "incr.missing_guard": {
          "description": "Incremental model reprocesses all input each run. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "incr.no_unique_key": {
          "description": "Merge strategy without a unique_key. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "incr.subquery_watermark": {
          "description": "Subquery filter does not prune. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "join.cartesian": {
          "description": "Join with no key. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "join.distinct_fanout": {
          "description": "DISTINCT may hide join fan-out. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "join.key_type_mismatch": {
          "description": "Join keys have different types. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "join.left_nullified": {
          "description": "WHERE makes this LEFT JOIN inner. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "join.redundant_left": {
          "description": "LEFT JOIN adds nothing. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "limit.no_scan_reduction": {
          "description": "LIMIT does not reduce bytes read. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "model.unused_cte": {
          "description": "CTE never used. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "order.in_cte": {
          "description": "ORDER BY has no effect here. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "set.union_distinct": {
          "description": "UNION dedupes; UNION ALL? (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "subq.correlated": {
          "description": "Correlated subquery. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        },
        "subq.not_in_nullable": {
          "description": "NOT IN over a nullable column can return nothing. (off|hint|info|warning)",
          "type": "string",
          "enum": [
            "off",
            "hint",
            "info",
            "warning"
          ]
        }
      }
    },
    "profiles": {
      "description": "dbt profiles overrides — hot: editing these re-resolves the active profile/target.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "description": "Profiles readable besides the project's own (like --profiles-allow). ([names])",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dir": {
          "description": "Directory containing profiles.yml (like --profiles-dir). (path)",
          "type": "string"
        },
        "profile": {
          "description": "Active profile override; empty means the project's own. (name)",
          "type": "string"
        },
        "target": {
          "description": "Active target override (like --target). (name)",
          "type": "string"
        }
      }
    },
    "refresh": {
      "description": "Context-refresh scheduling.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debounce_ms": {
          "description": "Coalescing window for refresh triggers. (ms)",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "startup": {
      "description": "Launch-only keys (install-once subsystems); honored via --config, a restart applies changes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debug": {
          "description": "Plain-text logging to log.txt beside the executable. (bool)",
          "type": "boolean"
        },
        "fusion": {
          "description": "dbt Fusion binary path enabling compile diagnostics. (path)",
          "type": "string"
        },
        "otlp": {
          "description": "OTLP trace/metric export endpoint; empty uses the SDK default. (url)",
          "type": "string"
        },
        "tree_sitter": {
          "description": "Tree-sitter document backend (false: phase-1 pipeline). (bool)",
          "type": "boolean"
        }
      }
    },
    "warehouse": {
      "description": "Warehouse introspection (duckdb builds only).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": {
          "description": "Complete source columns from the warehouse when the YAML has none. (bool)",
          "type": "boolean"
        }
      }
    }
  }
}
